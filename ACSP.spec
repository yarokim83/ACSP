# -*- mode: python ; coding: utf-8 -*-
from PyInstaller.utils.hooks import collect_submodules

# NumPy's native extensions import core modules dynamically (including _exceptions).
# Collect core runtime modules explicitly; older PyInstaller hooks miss some of them.
numpy_core_imports = collect_submodules('numpy._core', filter=lambda name: '.tests' not in name)

a = Analysis(
    ['run.py'],
    pathex=[],
    binaries=[],
    datas=[('ACSP', 'ACSP'), ('CraneOn.png', '.'), ('icon.ico', '.')],
    hiddenimports=numpy_core_imports + [
        'ACSP.work_tracking',
        'ACSP.ui.work_dashboard',
        'waitress',
        'ACSP.pms',
        'ACSP.pms_server',
        'ACSP.ui.pms',
        'ACSP.ui.pms_network',
        'ACSP.ui.report',
        'ACSP.ui.rm_list',
        'ACSP.logic.report_generator',
        'ACSP.version',
        'win32com',
        'win32com.client',
        'pywintypes',
        'matplotlib',
        'matplotlib.pyplot',
        'matplotlib.patches',
        'matplotlib.backends.backend_agg',
        'matplotlib.figure',
        'matplotlib.axes',
        'matplotlib.font_manager',
        'matplotlib.ticker',
        'PIL',
        'PIL.Image',
        'PIL.ImageTk',
    ],
    hookspath=[],
    hooksconfig={},
    runtime_hooks=[],
    excludes=[
        # This app uses PNG/ICO and Outlook COM, not AVIF, XML tooling or MFC UI.
        'PIL.AvifImagePlugin',
        'PIL._avif',
        'win32ui',
        'pywin',
        'lxml',
        'pandas',
        'openpyxl',
        'jinja2',
        'scipy',
        'IPython',
        'notebook',
        'pytz',
        'tornado',
        'zmq',
    ],
    noarchive=False,
    optimize=0,
)
pyz = PYZ(a.pure)

exe = EXE(
    pyz,
    a.scripts,
    a.binaries,
    a.datas,
    [],
    name='CRANEON',
    debug=False,
    bootloader_ignore_signals=False,
    strip=False,
    upx=True,
    upx_exclude=[],
    runtime_tmpdir=None,
    console=False,
    disable_windowed_traceback=False,
    argv_emulation=False,
    target_arch=None,
    codesign_identity=None,
    entitlements_file=None,
    icon=['icon.ico'],
)
